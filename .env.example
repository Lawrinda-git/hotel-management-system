# Email delivery uses Brevo's transactional API.
BREVO_API_KEY=replace-with-brevo-api-key
DEFAULT_FROM_EMAIL=StayHub <verified-sender@example.com>
BREVO_SMS_SENDER=StayHub

# SMTP fallback configuration (only used if you explicitly select the SMTP backend).
EMAIL_BACKEND=frontend.email_backend.BrevoEmailBackend
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-login
SMTP_PASSWORD=replace-with-smtp-key
SMTP_USE_TLS=true

# Create a Web application client in Google Cloud Console.  Register this
# exact local callback for development and change it for your deployed domain.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret

# ──────────────────────────────────────────────────────────────────────────
#  PUBLIC BASE URL — THE SINGLE PLACE TO CHANGE YOUR DEPLOYMENT DOMAIN.
#  Change this one value to re-point Paystack (return + webhook), Google
#  OAuth redirect URIs, and any externally-visible URLs to the new host.
#  e.g. https://your-tunnel.devtunnels.ms  or  https://your-domain.com
# ──────────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000

# Override any derived URL if you need a different path (rarely needed).
# PAYSTACK_RETURN_URL=http://localhost:8000/booking/
# PAYSTACK_WEBHOOK_URL=http://localhost:8000/api/billing/paystack/webhook/
# GOOGLE_OAUTH_REDIRECT_URIS=...

# Required for administrator signup outside local DEBUG mode.
ADMIN_SIGNUP_KEY=replace-with-private-admin-signup-key

# Database. Use sqlite for local fallback, or postgres to connect to the database engineer's schema.
DB_ENGINE=sqlite
DB_NAME=hotel_management
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432

# Paystack payment configuration.
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_PUBLIC_KEY=replace-with-paystack-public-key